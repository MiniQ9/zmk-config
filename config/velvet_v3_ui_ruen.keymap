#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        cap_sen: cap_sen {
            compatible = "zmk,behavior-hold-tap";
            label = "CAP_SEN";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        mouse_layer: mouse_layer {
            compatible = "zmk,behavior-sticky-key";
            label = "MOUSE_LAYER";
            bindings = <&mo>;
            #binding-cells = <1>;
            release-after-ms = <200>;
        };

        stiky_swap: stiky_swap {
            compatible = "zmk,behavior-sticky-key";
            label = "STIKY_SWAP";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            hold-trigger-key-positions = <6 7 8 9 10 11 23 22 21 20 19 18 30 31 32 33 34 35 44 45 42 41 43>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 4 5 12 13 14 15 16 17 29 27 28 26 25 24 37 36 38 39 40>;
        };

        lt2: lt2 {
            compatible = "zmk,behavior-hold-tap";
            label = "LT2";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            hold-while-undecided;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
        };

        zip_auto_mouse: zip_auto_mouse {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
            require-prior-idle-ms = <800>;
            excluded-positions = <>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cmben {
            bindings = <&layer_en>;
            key-positions = <3 2>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <8 9>;
        };

        LeftReset {
            bindings = <&sys_reset>;
            key-positions = <12 13>;
            timeout-ms = <100>;
        };

        RightReset {
            bindings = <&sys_reset>;
            key-positions = <23 22>;
            timeout-ms = <100>;
        };

        LeftMapLoad {
            bindings = <&bootloader>;
            key-positions = <24 25>;
            require-prior-idle-ms = <100>;
        };

        RightMapLoad {
            bindings = <&bootloader>;
            key-positions = <34 35>;
            require-prior-idle-ms = <100>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_CONTROL>,
                <&macro_wait_time 25>,
                <&kp K_CONTEXT_MENU>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp K_APP &kp RIGHT_CONTROL>,
                <&macro_tap>,
                <&macro_wait_time 50>;

            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 25>,
                <&kp LEFT_GUI>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_GUI &kp LEFT_CONTROL>,
                <&macro_tap>,
                <&macro_wait_time 50>;

            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_wait_time 25>,
                <&kp LEFT_GUI>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_GUI &kp LEFT_CONTROL>,
                <&macro_wait_time 25>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_wait_time 25>,
                <&macro_press>,
                <&kp RIGHT_CONTROL>,
                <&macro_wait_time 25>,
                <&kp K_CONTEXT_MENU>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp K_CONTEXT_MENU &kp RIGHT_CONTROL>,
                <&macro_tap>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        sen_mo: sen_mo {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_wait_time 150>,
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_press>;

            label = "SEN_MO";
        };

        swapper: swapper {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&macro_param_2to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &stiky_swap MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "SWAPPER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&none       &kp GRAVE        &kp Y            &kp A              &kp U                &kp SQT                                   &kp W     &kp G         &kp N               &kp K             &none             &kp PRINTSCREEN
&kp TAB     &hml LEFT_GUI Q  &hml LEFT_ALT I  &hml LEFT_SHIFT O  &hml LEFT_CONTROL E  &kp UNDER                                 &kp P     &hmr RCTRL D  &hmr RIGHT_SHIFT R  &hmr RIGHT_ALT V  &hmr RIGHT_GUI H  &kp CAPSLOCK
&kp K_MENU  &kp J            &kp C            &kp F              &mkp MB1             &kp Z                                     &kp B     &kp S         &kp L               &kp M             &kp X             &none
                             &kp LC(INSERT)   &kp LS(INSERT)     &kp ESC              &lt2 2 SPACE  &kp ENTER    &kp BACKSPACE  &lt2 4 T  &none         &kp RC(C)           &kp RC(V)
            >;

            display-name = "Base";
        };

        ru {
            display-name = "Ru";
            bindings = <
&none       &kp RU_CYRILLIC_HARD_SIGN  &kp RU_CYRILLIC_U            &kp RU_CYRILLIC_A              &kp RU_CYRILLIC_YU                &kp RU_CYRILLIC_E                                      &kp RU_CYRILLIC_SHA    &kp RU_CYRILLIC_GHE                &kp RU_CYRILLIC_EN               &kp RU_CYRILLIC_KA             &kp RU_CYRILLIC_ZHE  &kp PRINTSCREEN
&kp TAB     &kp RU_CYRILLIC_YA         &hml LEFT_ALT RU_CYRILLIC_I  &hml LEFT_SHIFT RU_CYRILLIC_O  &hml LEFT_CONTROL RU_CYRILLIC_IE  &kp RU_CYRILLIC_SOFT_SIGN                              &kp RU_CYRILLIC_PE     &hmr RIGHT_CONTROL RU_CYRILLIC_DE  &hmr RIGHT_SHIFT RU_CYRILLIC_ER  &hmr RIGHT_ALT RU_CYRILLIC_VE  &kp RU_CYRILLIC_CHE  &kp CAPSLOCK
&kp K_MENU  &kp RU_CYRILLIC_SHORT_I    &kp RU_CYRILLIC_TSE          &kp RU_CYRILLIC_EF             &mkp MB1                          &kp RU_CYRILLIC_ZE                                     &kp RU_CYRILLIC_BE     &kp RU_CYRILLIC_ES                 &kp RU_CYRILLIC_EL               &kp RU_CYRILLIC_EM             &kp RU_CYRILLIC_HA   &none
                                       &kp LC(INSERT)               &kp LS(INSERT)                 &kp ESC                           &lt2 3 SPACE               &kp ENTER    &kp BACKSPACE  &lt2 5 RU_CYRILLIC_TE  &none                              &en RC(C)                        &en RC(V)
            >;
        };

        sym_nav_en {
            bindings = <
&none  &kp TILDE  &kp AT                 &kp HASH               &kp DOLLAR        &kp DQT                               &none       &kp HOME        &kp UP          &kp END          &kp PRCNT             &none
&none  &kp PIPE   &hml LEFT_ALT CARET    &hml LEFT_SHIFT COLON  &hml LCTRL EQUAL  &kp SEMI                              &kp INS     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &hmr RIGHT_GUI PG_UP  &none
&none  &kp AMPS   &kp EXCL               &kp QMARK              &none             &none                                 &kp DEL     &mkp MB1        &mkp MB3        &mkp MB2         &kp PG_DN             &none
                  &swapper LEFT_ALT TAB  &swapper LCTRL TAB     &none             &none     &none    &kp RC(BACKSPACE)  &lt2 6 DOT  &none           &none           &none
            >;

            display-name = "Symbols  + Navigation en";
        };

        sym_nav_ru {
            display-name = "Symbols + Navigation ru";
            bindings = <
&kp RU_NUMERO  &en TILDE  &en AT                 &en HASH                   &en DOLLAR                &en DQT                                         &kp RU_CYRILLIC_SHCHA  &kp HOME        &kp UP          &kp END          &kp PRCNT             &none
&none          &kp PIPE   &en CARET              &hml RIGHT_SHIFT RU_COLON  &hml RIGHT_CONTROL EQUAL  &kp RU_SEMI                                     &kp INS                &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &hmr RIGHT_GUI PG_UP  &none
&none          &en AMPS   &kp RU_EXCLAMATION     &kp RU_QUESTION            &kp RU_CYRILLIC_YERU      &kp RU_CYRILLIC_IO                              &kp DEL                &mkp MB1        &mkp MB3        &mkp MB2         &kp PG_DN             &none
                          &swapper LEFT_ALT TAB  &swapper LCTRL TAB         &none                     &none               &none    &kp RC(BACKSPACE)  &lt2 6 RU_DOT          &none           &none           &none
            >;
        };

        fn_num_en {
            bindings = <
&kp LPAR          &kp RPAR           &kp F1            &kp F2              &kp F3                &kp F4                                &kp KP_ASTERISK  &kp N7               &kp N8                     &kp N9             &kp KP_MINUS       &none
&kp LEFT_BRACKET  &kp RIGHT_BRACKET  &hml LEFT_ALT F5  &hml LEFT_SHIFT F6  &hml LEFT_CONTROL F7  &kp F8                                &kp KP_SLASH     &hmr LCTRL NUMBER_4  &hmr RIGHT_SHIFT NUMBER_5  &hmr RIGHT_ALT N6  &hmr RGUI KP_PLUS  &none
&kp LESS_THAN     &kp GREATER_THAN   &kp F9            &kp F10             &kp F11               &kp F12                               &kp BSLH         &kp N1               &kp NUMBER_2               &kp NUMBER_3       &kp ENTER          &none
                                     &kp LEFT_BRACE    &kp RIGHT_BRACE     &kp LC(Z)             &lt2 6 COMMA  &kp RS(ENTER)    &none  &trans           &none                &kp N0                     &kp KP_DOT
            >;

            display-name = "F1-F12 + Numbers en";
        };

        fn_num_ru {
            display-name = "F1-F12 + Numbers ru";
            bindings = <
&kp LPAR          &kp RPAR           &kp F1            &kp F2              &kp F3                &kp F4                                   &kp KP_ASTERISK  &kp N7               &kp N8                     &kp N9             &kp KP_MINUS       &none
&en LEFT_BRACKET  &en RIGHT_BRACKET  &hml LEFT_ALT F5  &hml LEFT_SHIFT F6  &hml LEFT_CONTROL F7  &kp F8                                   &kp KP_DIVIDE    &hmr RCTRL NUMBER_4  &hmr RIGHT_SHIFT NUMBER_5  &hmr RIGHT_ALT N6  &hmr RGUI KP_PLUS  &none
&en LESS_THAN     &en GREATER_THAN   &kp F9            &kp F10             &kp F11               &kp F12                                  &kp BACKSLASH    &kp N1               &kp NUMBER_2               &kp NUMBER_3       &kp ENTER          &none
                                     &en LEFT_BRACE    &en RIGHT_BRACE     &en LC(Z)             &lt2 6 RU_COMMA  &kp RS(ENTER)    &none  &trans           &none                &kp KP_N0                  &kp KP_DOT
            >;
        };

        adj {
            bindings = <
&bootloader  &none  &none       &none  &none  &none                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bootloader
&none        &none  &none       &none  &none  &none                  &out OUT_BLE  &kp C_VOL_DN  &kp K_MUTE        &kp C_VOL_UP  &bt BT_CLR    &studio_unlock
&none        &none  &none       &none  &none  &none                  &out OUT_USB  &kp K_PREV    &kp K_PLAY_PAUSE  &kp K_NEXT    &none         &none
                    &sys_reset  &none  &none  &none  &none    &none  &none         &none         &none             &sys_reset
            >;

            display-name = "Adjust";
        };

        mouse {
            bindings = <
&none  &none  &none     &none     &none     &none                  &none  &none     &none     &none     &none  &none
&none  &mo 8  &mkp MB3  &mkp MB2  &mkp MB1  &mo 9                  &mo 9  &mkp MB1  &mkp MB2  &mkp MB3  &mo 8  &none
&none  &none  &none     &none     &none     &none                  &none  &none     &none     &none     &none  &none
              &none     &none     &none     &none  &none    &none  &none  &trans    &none     &none
            >;

            display-name = "Mouse";
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Scroll";
        };

        sniper {
            bindings = <
&none  &none  &none     &none     &none     &none                  &none  &none     &none     &none     &none  &none
&none  &none  &mkp MB3  &mkp MB2  &mkp MB1  &none                  &none  &mkp MB3  &mkp MB2  &mkp MB1  &none  &none
&none  &none  &none     &none     &none     &none                  &none  &none     &none     &none     &none  &none
              &none     &none     &none     &none  &none    &none  &none  &trans    &none     &none
            >;

            display-name = "Sniper";
        };
    };
};

&trackball { cpi = <1400>; };

&trackball_listener {
    input-processors = <&zip_xy_scaler 9 20>;

    scroller {
        layers = <2 3>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_scaler 1 128>,
            <&zip_xy_to_scroll_mapper>;
    };

    sniper {
        layers = <9>;
        input-processors = <&zip_xy_scaler 1 4>;
    };
};
